
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'test', 'prod'],
            description: 'Terraform environment'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply'],
            description: 'Terraform action'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'ap-south-1'
        SECRETS_MANAGER_REGION = 'us-east-1'
        SECRET_ID = 'database_secrets'

        GEMINI_MODEL_ID = 'gemini-3.8-flash'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Initialize build log') {
            steps {
                sh '''
                    set -eu
                    : > "$WORKSPACE/pipeline.log"
                '''
            }
        }

        stage('Validate inputs and tools') {
            steps {
                script {
                    if (!(params.ENVIRONMENT in ['dev', 'test', 'prod'])) {
                        error("Unsupported environment")
                    }

                    env.TF_ROOT =
                        "terraform/environments/${params.ENVIRONMENT}"
                }

                sh '''#!/bin/bash
                    set -Eeuo pipefail
                    exec > >(tee -a "$WORKSPACE/pipeline.log") 2>&1

                    test -d "$TF_ROOT"

                    command -v terraform
                    command -v aws
                    command -v jq
                    command -v python3

                    terraform version
                    aws --version

                    echo "Checking AWS IAM role..."
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Terraform fmt, init and validate') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/bin/bash
                        set -Eeuo pipefail
                        exec > >(tee -a "$WORKSPACE/pipeline.log") 2>&1

                        terraform fmt -check -recursive ../../..
                        terraform init -input=false
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/bin/bash
                        set -Eeuo pipefail
                        set +x
                        exec > >(tee -a "$WORKSPACE/pipeline.log") 2>&1

                        echo "Getting DB password from AWS Secrets Manager"

                        DB_PASSWORD="$(aws secretsmanager get-secret-value \
                            --region "$SECRETS_MANAGER_REGION" \
                            --secret-id "$SECRET_ID" \
                            --query SecretString \
                            --output text |
                            jq -r --arg key \
                            "techverito/${ENVIRONMENT}/db-password" \
                            '.[$key] // empty')"

                        if [[ -z "$DB_PASSWORD" || "$DB_PASSWORD" == "null" ]]; then
                            echo "Database password not found"
                            exit 1
                        fi

                        export TF_VAR_db_password="$DB_PASSWORD"
                        unset DB_PASSWORD

                        terraform plan \
                            -input=false \
                            -lock-timeout=5m \
                            -out=tfplan

                        unset TF_VAR_db_password
                    '''
                }
            }
        }

        stage('Approve production apply') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' }
                    expression { params.ENVIRONMENT == 'prod' }
                }
            }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: 'Approve production Terraform apply?',
                        ok: 'Approve'
                    )
                }
            }
        }

        stage('Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/bin/bash
                        set -Eeuo pipefail
                        exec > >(tee -a "$WORKSPACE/pipeline.log") 2>&1

                        test -f tfplan

                        terraform apply \
                            -input=false \
                            -lock-timeout=5m \
                            tfplan
                    '''
                }
            }
        }
    }

    post {
        failure {
            script {
                echo "Pipeline failed. Starting Gemini AI analysis."

                int analyzerStatus = -1

                withCredentials([
                    string(
                        credentialsId: 'gemini-api-key',
                        variable: 'GEMINI_API_KEY'
                    )
                ]) {
                    analyzerStatus = sh(
                        script: '''#!/bin/bash
                            set +x
                            set -Eeuo pipefail

                            python3 scripts/ai_failure_analyzer.py
                        ''',
                        returnStatus: true
                    )
                }

                if (fileExists('AI_FAILURE_REPORT.md')) {
                    archiveArtifacts(
                        artifacts: 'AI_FAILURE_REPORT.md',
                        fingerprint: true
                    )

                    echo "Gemini AI report archived successfully."
                } else {
                    echo "AI analyzer failed with exit code: ${analyzerStatus}"
                }
            }
        }

        cleanup {
            script {
                if (env.TF_ROOT) {
                    dir("${env.TF_ROOT}") {
                        sh 'rm -f tfplan || true'
                    }
                }

                deleteDir()
            }
        }

        success {
            echo "Terraform ${params.ACTION} completed for ${params.ENVIRONMENT}."
        }
    }
}
