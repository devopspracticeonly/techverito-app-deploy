
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        choice(name: 'ENVIRONMENT', choices: ['dev', 'test', 'prod'],
               description: 'Terraform environment to deploy')
        choice(name: 'ACTION', choices: ['plan', 'apply'],
               description: 'Run a Terraform plan or apply the generated plan')
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_SECRETS_REGION = 'us-east-1'
        DB_SECRET_ID = 'database_secrets'
        GEMINI_SECRET_ID = 'gemini_access_token'
        GEMINI_SECRET_JSON_KEY = 'gemini_access_token'
        GEMINI_MODEL_ID = 'gemini-3.8-flash'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh '''#!/usr/bin/env bash
                    set -Eeuo pipefail
                    : > "$WORKSPACE/pipeline.log"
                    echo "Build started: ${JOB_NAME} #${BUILD_NUMBER}" | tee -a "$WORKSPACE/pipeline.log"
                    echo "Environment: ${ENVIRONMENT}; action: ${ACTION}" | tee -a "$WORKSPACE/pipeline.log"
                '''
            }
        }

        stage('Validate inputs, tools and AWS role') {
            steps {
                script {
                    if (!(params.ENVIRONMENT in ['dev', 'test', 'prod'])) {
                        error("Unsupported environment: ${params.ENVIRONMENT}")
                    }
                    env.TF_ROOT = "terraform/environments/${params.ENVIRONMENT}"
                }
                sh '''#!/usr/bin/env bash
                    set -Eeuo pipefail
                    {
                        test -d "$TF_ROOT"
                        command -v terraform
                        command -v aws
                        command -v python3
                        terraform version
                        aws --version
                        aws sts get-caller-identity
                    } 2>&1 | tee -a "$WORKSPACE/pipeline.log"
                '''
            }
        }

        stage('Terraform fmt, init and validate') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        {
                            terraform fmt -check -recursive ../../..
                            terraform init -input=false
                            terraform validate
                        } 2>&1 | tee -a "$WORKSPACE/pipeline.log"
                    '''
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x
                        export DB_SECRET_JSON_KEY="techverito/${ENVIRONMENT}/db-password"

                        DB_PASSWORD="$(
                            aws secretsmanager get-secret-value \
                                --secret-id "$DB_SECRET_ID" \
                                --region "$AWS_SECRETS_REGION" \
                                --query SecretString \
                                --output text 2>> "$WORKSPACE/pipeline.log" |
                            python3 -c '
import json, os, sys
secret = json.load(sys.stdin)
key = os.environ["DB_SECRET_JSON_KEY"]
value = secret.get(key)
if not isinstance(value, str) or not value:
    raise SystemExit("Database password key is missing or empty in Secrets Manager.")
print(value)
'
                        )"

                        if [[ -z "$DB_PASSWORD" ]]; then
                            echo "Database password retrieval returned an empty value." | tee -a "$WORKSPACE/pipeline.log"
                            exit 1
                        fi

                        export TF_VAR_db_password="$DB_PASSWORD"
                        unset DB_PASSWORD

                        terraform plan \
                            -input=false \
                            -lock-timeout=5m \
                            -out=tfplan \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        unset TF_VAR_db_password
                    '''
                }
            }
        }

        stage('Approve production apply') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' }
                    expression { params.ENVIRONMENT == 'prod' }
                }
            }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: 'Approve applying the reviewed Terraform plan to PRODUCTION?',
                        ok: 'Approve production apply'
                    )
                }
            }
        }

        stage('Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir("${TF_ROOT}") {
                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x
                        test -f tfplan
                        export DB_SECRET_JSON_KEY="techverito/${ENVIRONMENT}/db-password"

                        DB_PASSWORD="$(
                            aws secretsmanager get-secret-value \
                                --secret-id "$DB_SECRET_ID" \
                                --region "$AWS_SECRETS_REGION" \
                                --query SecretString \
                                --output text 2>> "$WORKSPACE/pipeline.log" |
                            python3 -c '
import json, os, sys
secret = json.load(sys.stdin)
key = os.environ["DB_SECRET_JSON_KEY"]
value = secret.get(key)
if not isinstance(value, str) or not value:
    raise SystemExit("Database password key is missing or empty in Secrets Manager.")
print(value)
'
                        )"

                        if [[ -z "$DB_PASSWORD" ]]; then
                            echo "Database password retrieval returned an empty value." | tee -a "$WORKSPACE/pipeline.log"
                            exit 1
                        fi

                        export TF_VAR_db_password="$DB_PASSWORD"
                        unset DB_PASSWORD

                        terraform apply \
                            -input=false \
                            -lock-timeout=5m \
                            tfplan \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        unset TF_VAR_db_password
                    '''
                }
            }
        }
    }

    post {
        failure {
            script {
                echo 'Pipeline failed. Starting Gemini failure analysis.'

                catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x

                        mkdir -p "$WORKSPACE"
                        touch "$WORKSPACE/pipeline.log"

                        echo "Starting Gemini analysis for ${JOB_NAME} #${BUILD_NUMBER}" \
                            | tee -a "$WORKSPACE/pipeline.log"

                        export GEMINI_API_KEY="$(
                            aws secretsmanager get-secret-value \
                                --secret-id "$GEMINI_SECRET_ID" \
                                --region "$AWS_SECRETS_REGION" \
                                --query SecretString \
                                --output text 2>> "$WORKSPACE/pipeline.log" |
                            python3 -c '
import json, os, sys
secret = json.load(sys.stdin)
key = os.environ["GEMINI_SECRET_JSON_KEY"]
value = secret.get(key)
if not isinstance(value, str) or not value:
    raise SystemExit("Gemini API key is missing or empty in Secrets Manager.")
print(value)
'
                        )"

                        export GEMINI_MODEL_ID JOB_NAME BUILD_NUMBER ENVIRONMENT ACTION

                        python3 scripts/ai_failure_analyzer.py \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        unset GEMINI_API_KEY
                    '''

                    // Print the complete Gemini report in Jenkins Console Output.
                    echo "========== GEMINI AI FAILURE REPORT =========="

                    sh '''
                        if [ -f AI_FAILURE_REPORT.md ]; then
                            cat AI_FAILURE_REPORT.md
                        else
                            echo "AI_FAILURE_REPORT.md was not generated."
                        fi
                    '''

                    echo "========== END OF GEMINI AI REPORT =========="
                }

                // Archive report and logs even if Gemini analysis fails.
                archiveArtifacts(
                    artifacts: 'AI_FAILURE_REPORT.md,pipeline.log',
                    allowEmptyArchive: true,
                    fingerprint: true
                )
            }
        }

        success {
            echo "Terraform ${params.ACTION} completed for ${params.ENVIRONMENT}."
        }

        always {
            script {
                if (env.TF_ROOT) {
                    dir("${env.TF_ROOT}") {
                        sh 'rm -f tfplan || true'
                    }
                }
            }
        }

        cleanup {
            deleteDir()
        }
    }
}
