
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        choice(
            name: 'ENVIRONMENT',
            choices: ['dev', 'test', 'prod'],
            description: 'Terraform environment'
        )
        choice(
            name: 'ACTION',
            choices: ['plan', 'apply'],
            description: 'Terraform action'
        )
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        SECRETS_MANAGER_REGION = 'us-east-1'
        SECRET_ID = 'database_secrets'
        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Validate inputs and tools') {
            steps {
                script {
                    if (!(params.ENVIRONMENT in ['dev', 'test', 'prod'])) {
                        error("Unsupported environment: ${params.ENVIRONMENT}")
                    }

                    env.TF_ROOT =
                        "terraform/environments/${params.ENVIRONMENT}"
                }

                sh '''
                    set -eu

                    test -d "$TF_ROOT"

                    command -v terraform
                    command -v aws
                    command -v jq

                    terraform version
                    aws --version

                    echo "Checking AWS IAM role authentication..."
                    aws sts get-caller-identity
                '''
            }
        }

        stage('Terraform fmt, init and validate') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''
                        set -eu

                        terraform fmt -check -recursive ../../..
                        terraform init -input=false
                        terraform validate
                    '''
                }
            }
        }

        stage('Terraform plan') {
            steps {
                dir("${TF_ROOT}") {
                    sh '''
                        set +x
                        set -eu

                        echo "Retrieving database password from AWS Secrets Manager..."

                        DB_PASSWORD=$(aws secretsmanager get-secret-value \
                            --region "$SECRETS_MANAGER_REGION" \
                            --secret-id "$SECRET_ID" \
                            --query SecretString \
                            --output text |
                            jq -r --arg key "techverito/${ENVIRONMENT}/db-password" \
                            '.[$key] // empty')

                        if [ -z "$DB_PASSWORD" ] || [ "$DB_PASSWORD" = "null" ]; then
                            echo "ERROR: Database password not found in Secrets Manager"
                            exit 1
                        fi

                        export TF_VAR_db_password="$DB_PASSWORD"

                        echo "Running Terraform plan..."

                        terraform plan \
                            -input=false \
                            -lock-timeout=5m \
                            -out=tfplan

                        unset TF_VAR_db_password
                        unset DB_PASSWORD
                    '''
                }
            }
        }

        stage('Approve production apply') {
            when {
                allOf {
                    expression { params.ACTION == 'apply' }
                    expression { params.ENVIRONMENT == 'prod' }
                }
            }
            steps {
                timeout(time: 15, unit: 'MINUTES') {
                    input(
                        message: 'Approve applying the reviewed Terraform plan to PRODUCTION?',
                        ok: 'Approve production apply'
                    )
                }
            }
        }

        stage('Apply') {
            when {
                expression { params.ACTION == 'apply' }
            }
            steps {
                dir("${TF_ROOT}") {
                    sh '''
                        set -eu

                        test -f tfplan

                        echo "Applying Terraform plan..."

                        terraform apply \
                            -input=false \
                            -lock-timeout=5m \
                            tfplan
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                if (env.TF_ROOT) {
                    dir("${env.TF_ROOT}") {
                        sh 'rm -f tfplan || true'
                    }
                }
            }

            deleteDir()
        }

        success {
            echo "Terraform ${params.ACTION} completed for ${params.ENVIRONMENT}."
        }

        failure {
            echo "Terraform pipeline failed for ${params.ENVIRONMENT}. Review the logs."
        }
    }
}
