
pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
        skipDefaultCheckout(true)
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    environment {
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_SECRETS_REGION = 'us-east-1'

        DB_SECRET_ID = 'database_secrets'
        GEMINI_SECRET_ID = 'gemini_access_token'
        GEMINI_SECRET_JSON_KEY = 'gemini_access_token'
        GEMINI_MODEL_ID = 'gemini-3.8-flash'

        TF_IN_AUTOMATION = 'true'
        TF_INPUT = 'false'

        // TF_ENVIRONMENT, TF_ACTION and TF_ROOT are set in the branch-mapping stage.

    }

    stages {

        // ---------------------------------------------
        // 1. CHECKOUT
        // ---------------------------------------------
        stage('Checkout') {
            steps {
                checkout scm

                sh '''#!/usr/bin/env bash
                    set -Eeuo pipefail

                    : > "$WORKSPACE/pipeline.log"

                    echo "Build: ${JOB_NAME} #${BUILD_NUMBER}" \
                        | tee -a "$WORKSPACE/pipeline.log"

                '''
            }
        }


        // ---------------------------------------------
        // 2. SELECT TF_ENVIRONMENT AND TF_ACTION FROM BRANCH
        // ---------------------------------------------
        stage('Set deployment environment') {
            steps {
                script {
                    // Initialize imperatively so later stages can update this value.
                    // Keep TF_CHECKS_PASSED out of the top-level environment block.
                    env.TF_CHECKS_PASSED = 'false'

                    def branch = env.BRANCH_NAME?.trim()

                    if (!branch) {
                        error('BRANCH_NAME is not available. Run this pipeline as a Jenkins Multibranch Pipeline.')
                    }

                    switch (branch) {
                        case 'dev':
                            env.TF_ENVIRONMENT = 'dev'
                            env.TF_ACTION = 'apply'
                            break

                        case 'test':
                            env.TF_ENVIRONMENT = 'test'
                            env.TF_ACTION = 'apply'
                            break

                        case 'main':
                            env.TF_ENVIRONMENT = 'prod'
                            env.TF_ACTION = 'apply'
                            break

                        default:
                            // Only dev, test and main deploy. Other branches run plan only.
                            env.TF_ENVIRONMENT = 'dev'
                            env.TF_ACTION = 'plan'
                            break
                    }

                    env.TF_ROOT = "terraform/environments/${env.TF_ENVIRONMENT}"

                    currentBuild.description = "Branch: ${branch} | Environment: ${env.TF_ENVIRONMENT} | Action: ${env.TF_ACTION}"

                    echo '========== BRANCH DEPLOYMENT CONFIGURATION =========='
                    echo "Git branch: ${branch}"
                    echo "Terraform environment: ${env.TF_ENVIRONMENT}"
                    echo "Pipeline action: ${env.TF_ACTION}"
                    echo "Terraform root: ${env.TF_ROOT}"
                    echo "Initial Terraform checks status: ${env.TF_CHECKS_PASSED}"
                }
            }
        }

        // ---------------------------------------------
        // 3. VALIDATE TOOLS AND AWS ROLE
        // ---------------------------------------------
        stage('Validate inputs, tools and AWS role') {
            steps {
                script {
                    if (!(env.TF_ENVIRONMENT in ['dev', 'test', 'prod'])) {
                        error("Unsupported environment selected from branch: ${env.TF_ENVIRONMENT}")
                    }

                    if (!(env.TF_ACTION in ['plan', 'apply'])) {
                        error("Unsupported pipeline action selected from branch: ${env.TF_ACTION}")
                    }

                    echo "Validated branch mapping: ${env.BRANCH_NAME} -> ${env.TF_ENVIRONMENT} (${env.TF_ACTION})"
                }

                sh '''#!/usr/bin/env bash
                    set -Eeuo pipefail

                    {
                        test -d "$TF_ROOT"

                        echo "Checking Terraform..."
                        command -v terraform
                        terraform version

                        echo "Checking AWS CLI..."
                        command -v aws
                        aws --version

                        echo "Checking Python..."
                        command -v python3
                        python3 --version

                        echo "Checking AWS identity..."
                        aws sts get-caller-identity

                    } 2>&1 | tee -a "$WORKSPACE/pipeline.log"
                '''
            }
        }

        // ---------------------------------------------
        // 4. TERRAFORM FMT, INIT AND VALIDATE
        // ALLOW FAILURE AND CONTINUE
        // ---------------------------------------------
        stage('Terraform fmt, init and validate') {
            steps {
                dir("${TF_ROOT}") {
                    script {

                        def checkStatus = sh(
                            returnStatus: true,
                            script: '''#!/usr/bin/env bash
                                set -uo pipefail

                                STATUS=0

                                echo "========== TERRAFORM FMT =========="

                                terraform fmt -check -recursive \
                                    "$WORKSPACE/terraform" \
                                    2>&1 | tee -a "$WORKSPACE/pipeline.log"

                                FMT_STATUS=${PIPESTATUS[0]}

                                if [[ $FMT_STATUS -ne 0 ]]; then
                                    echo "WARNING: Terraform fmt failed."
                                    STATUS=1
                                fi

                                echo "========== TERRAFORM INIT =========="

                                terraform init -input=false \
                                    2>&1 | tee -a "$WORKSPACE/pipeline.log"

                                INIT_STATUS=${PIPESTATUS[0]}

                                if [[ $INIT_STATUS -ne 0 ]]; then
                                    echo "WARNING: Terraform init failed."
                                    STATUS=1
                                fi

                                echo "========== TERRAFORM VALIDATE =========="

                                terraform validate \
                                    2>&1 | tee -a "$WORKSPACE/pipeline.log"

                                VALIDATE_STATUS=${PIPESTATUS[0]}

                                if [[ $VALIDATE_STATUS -ne 0 ]]; then
                                    echo "WARNING: Terraform validate failed."
                                    STATUS=1
                                fi

                                echo "========== CHECK SUMMARY =========="

                                echo "FMT status: $FMT_STATUS"
                                echo "INIT status: $INIT_STATUS"
                                echo "VALIDATE status: $VALIDATE_STATUS"

                                exit $STATUS
                            '''
                        )

                        if (checkStatus != 0) {

                            env.TF_CHECKS_PASSED = 'false'

                            catchError(
                                buildResult: 'UNSTABLE',
                                stageResult: 'UNSTABLE',
                                message: 'Terraform checks failed. Continuing pipeline, but apply will be skipped.'
                            ) {
                                error('Terraform fmt/init/validate checks failed.')
                            }

                        } else {

                            env.TF_CHECKS_PASSED = 'true'

                            echo "All Terraform checks passed. TF_CHECKS_PASSED=${env.TF_CHECKS_PASSED}"
                        }
                    }
                }
            }
        }

        // ---------------------------------------------
        // 5. TERRAFORM PLAN
        // ---------------------------------------------
        stage('Terraform plan') {
            steps {
                dir("${TF_ROOT}") {

                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x

                        echo "Retrieving database password..."

                        export DB_SECRET_JSON_KEY="techverito/${TF_ENVIRONMENT}/db-password"

                        DB_PASSWORD="$(
                            aws secretsmanager get-secret-value \
                                --secret-id "$DB_SECRET_ID" \
                                --region "$AWS_SECRETS_REGION" \
                                --query SecretString \
                                --output text \
                                2>> "$WORKSPACE/pipeline.log" |
                            python3 -c '
import json, os, sys

secret = json.load(sys.stdin)
key = os.environ["DB_SECRET_JSON_KEY"]
value = secret.get(key)

if not isinstance(value, str) or not value:
    raise SystemExit("Database password is missing or empty.")

print(value)
'
                        )"

                        if [[ -z "$DB_PASSWORD" ]]; then
                            echo "Database password retrieval failed."
                            exit 1
                        fi

                        export TF_VAR_db_password="$DB_PASSWORD"
                        unset DB_PASSWORD

                        echo "Generating Terraform plan..."

                        terraform plan \
                            -input=false \
                            -lock-timeout=5m \
                            -out=tfplan \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        chmod 600 tfplan

                        unset TF_VAR_db_password

                        echo "Terraform plan completed."
                    '''
                }
            }
        }

        // ---------------------------------------------
        // 6. PRODUCTION APPROVAL
        // ---------------------------------------------
        stage('Approve Terraform apply') {
            when {
                expression {
                    def shouldApply =
                        env.TF_ACTION?.trim() == 'apply' &&
                        env.TF_CHECKS_PASSED?.trim() == 'true'

                    echo "Approval check - branch: ${env.BRANCH_NAME}"
                    echo "Approval check - environment: ${env.TF_ENVIRONMENT}"
                    echo "Approval check - action: ${env.TF_ACTION}"
                    echo "Approval check - Terraform checks passed: ${env.TF_CHECKS_PASSED}"

                    return shouldApply
                }
            }

            steps {
                timeout(time: 30, unit: 'MINUTES') {
                    input(
                        message: "Approve Terraform apply for ${env.TF_ENVIRONMENT.toUpperCase()} environment (branch: ${env.BRANCH_NAME})?",
                        ok: 'Approve Terraform apply'
                    )
                }
            }
        }

        // ---------------------------------------------
        // 7. TERRAFORM APPLY
        // SKIP IF CHECKS FAILED
        // ---------------------------------------------
        stage('Terraform apply') {
            when {
                expression {
                    def shouldApply =
                        env.TF_ACTION?.trim() == 'apply' &&
                        env.TF_CHECKS_PASSED?.trim() == 'true'

                    echo "Apply check - branch: ${env.BRANCH_NAME}"
                    echo "Apply check - environment: ${env.TF_ENVIRONMENT}"
                    echo "Apply check - action: ${env.TF_ACTION}"
                    echo "Apply check - Terraform checks passed: ${env.TF_CHECKS_PASSED}"

                    return shouldApply
                }
            }

            steps {
                dir("${TF_ROOT}") {

                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x

                        echo "Checking Terraform plan..."

                        test -f tfplan

                        echo "Applying saved Terraform plan..."

                        terraform apply \
                            -input=false \
                            -lock-timeout=5m \
                            tfplan \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        echo "Terraform apply completed successfully."
                    '''
                }
            }
        }
    }

    // ---------------------------------------------
    // POST BUILD TF_ACTIONS
    // ---------------------------------------------
    post {

        // -----------------------------------------
        // FAILURE OR UNSTABLE: GEMINI ANALYSIS
        // -----------------------------------------
        unsuccessful {
            script {

                echo 'Pipeline unsuccessful. Starting Gemini analysis.'

                catchError(
                    buildResult: 'UNSTABLE',
                    stageResult: 'UNSTABLE'
                ) {

                    sh '''#!/usr/bin/env bash
                        set -Eeuo pipefail
                        set +x

                        touch "$WORKSPACE/pipeline.log"

                        echo "Starting Gemini analysis..." \
                            | tee -a "$WORKSPACE/pipeline.log"

                        export GEMINI_API_KEY="$(
                            aws secretsmanager get-secret-value \
                                --secret-id "$GEMINI_SECRET_ID" \
                                --region "$AWS_SECRETS_REGION" \
                                --query SecretString \
                                --output text \
                                2>> "$WORKSPACE/pipeline.log" |
                            python3 -c '
import json, os, sys

secret = json.load(sys.stdin)
key = os.environ["GEMINI_SECRET_JSON_KEY"]
value = secret.get(key)

if not isinstance(value, str) or not value:
    raise SystemExit("Gemini API key is missing or empty.")

print(value)
'
                        )"

                        if [[ -z "$GEMINI_API_KEY" ]]; then
                            echo "Gemini API key retrieval failed."
                            exit 1
                        fi

                        export GEMINI_MODEL_ID
                        export JOB_NAME
                        export BUILD_NUMBER
                        export TF_ENVIRONMENT
                        export TF_ACTION

                        python3 scripts/ai_failure_analyzer.py \
                            2>&1 | tee -a "$WORKSPACE/pipeline.log"

                        unset GEMINI_API_KEY

                        echo "Gemini analysis completed."
                    '''

                    echo "========== GEMINI AI FAILURE REPORT =========="

                    sh '''#!/usr/bin/env bash
                        if [ -f AI_FAILURE_REPORT.md ]; then
                            cat AI_FAILURE_REPORT.md
                        else
                            echo "AI_FAILURE_REPORT.md was not generated."
                        fi
                    '''

                    echo "========== END OF GEMINI AI REPORT =========="
                }
            }
        }

        // -----------------------------------------
        // SUCCESS
        // -----------------------------------------
        success {
            script {
                if (env.TF_ACTION?.trim() == 'apply' &&
                    env.TF_CHECKS_PASSED?.trim() == 'true') {
                    echo "Pipeline completed successfully. Terraform apply finished for ${env.TF_ENVIRONMENT}."
                } else if (env.TF_CHECKS_PASSED?.trim() != 'true') {
                    echo "Pipeline completed, but Terraform apply was skipped because fmt/init/validate checks did not pass."
                } else {
                    echo "Terraform plan completed successfully for ${env.TF_ENVIRONMENT}. No apply was requested for this branch."
                }
            }
        }

        // -----------------------------------------
        // ALWAYS
        // -----------------------------------------
        always {

            archiveArtifacts(
                artifacts: 'AI_FAILURE_REPORT.md,pipeline.log',
                allowEmptyArchive: true,
                fingerprint: true
            )

            script {
                if (env.TF_ROOT) {
                    dir("${env.TF_ROOT}") {
                        sh 'rm -f tfplan || true'
                    }
                }
            }
        }

        // -----------------------------------------
        // CLEANUP
        // -----------------------------------------
        cleanup {
            deleteDir()
        }
    }
}
	